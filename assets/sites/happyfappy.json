    },
    {
      "id": "3",
      "displayName": "Gay / Bi",
      "parameters": "{\"filter_cat[3]\": \"1\"}"
    },
    {
      "id": "4",
      "displayName": "Interracial",
      "parameters": "{\"filter_cat[4]\": \"1\"}"
    },
    {
      "id": "5",
