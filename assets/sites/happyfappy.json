    "https://www.happyfappy.org/"
  ],
  "primaryUrl": "https://www.happyfappy.net/",
  "siteType": "Web",
  "operationIntervalMs": 1000,
  "searchCategories": [
    {
      "id": "all",
      "displayName": "All",
